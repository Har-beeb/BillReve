# BillReve client environment variables
#
# Copy to `.env.local` and fill in. Anything prefixed VITE_ is embedded into the
# client bundle at build time and is therefore PUBLIC — never put a secret key
# here. Merchant payment secret keys live encrypted in the `user_secrets` table
# and are only ever read server-side by edge functions.

# --- Supabase (required) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Observability (optional, but strongly recommended in production) ---
# Without these, production errors and usage are invisible. Both tools stay
# completely off when the corresponding key is absent.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
# Defaults to https://us.i.posthog.com when unset. Use https://eu.i.posthog.com
# for the EU region.
VITE_POSTHOG_HOST=

# --- Feature flags ---
VITE_ENABLE_CSV_IMPORT=false
